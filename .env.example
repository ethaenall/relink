# Optional. Never commit real values. Use .env.local (gitignored).

# Groq (preferred for $0 hackathon use). Key stays on the server only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Must be 1 before Relink will call Groq. Leave 0 to set up without spending.
GROQ_ARMED=0

# Featherless (hackathon sponsor). Used only if GROQ_API_KEY is unset.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional. Public URL of /api/diagnose on a Node host (Vercel).
# Baked into the Pages build via GitHub Actions variable LINKER_API_URL.
# Do not put any API key here.
NEXT_PUBLIC_LINKER_API=
